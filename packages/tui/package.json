{
  "name": "@fdg/tui",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external react",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@byteland/ink-scroll-bar": "^1.0.0",
    "@fdg/contracts": "workspace:*",
    "@fdg/sdk": "workspace:*",
    "ink": "^6.8.0",
    "ink-scroll-view": "^0.3.6",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  }
}
